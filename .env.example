# ==============================================================================
# SuryaGharSathi Environment Variables Template (.env.example)
# Copy this file to .env and insert your real API credentials.
# NEVER commit the active .env file to GitHub.
# ==============================================================================

# LLM Provider: 'gemini' (recommended) or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional, get free key from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Model name
LLM_MODEL=gemini-1.5-flash

# Sampling temperature (0.1 for strict factual grounding)
TEMPERATURE=0.1
